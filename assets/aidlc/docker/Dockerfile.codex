# AI-DLC worker image (OpenAI Codex CLI). Shipped and managed by aidlc-kit —
# build it with `aidlc-kit loop worker-image --provider codex` instead of by hand.
#
# The agent CLI must be on the system PATH: workers run non-root with a read-only
# root filesystem, so a global npm install lands the binary in /usr/local/bin.
# Use the scoped `@openai/codex` package (the unscoped `codex` npm package is
# unrelated).
FROM node:24-bookworm-slim
RUN npm install -g @openai/codex
