{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "nextAction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        {
          "type": "null"
        }
      ]
    },
    "hypothesis": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        {
          "type": "null"
        }
      ]
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completed": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "files": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "links": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    }
  },
  "required": [
    "schemaVersion",
    "goal",
    "nextAction",
    "state",
    "hypothesis",
    "capturedAt",
    "completed",
    "observations",
    "blockers",
    "files",
    "links"
  ]
}
