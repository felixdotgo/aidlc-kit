# Copy to .env, set distinct random credentials, then run:
# docker compose --profile fleet up -d fleet-coordination
# Bind through a TLS reverse proxy before exposing this service to other machines.
MCP_POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
# Existing local SQLite service in compose.yaml uses this only when started.
MCP_STATE_AUTH_TOKEN=replace-with-a-distinct-local-service-token
MCP_FLEET_LEAD_TOKEN=replace-with-a-distinct-lead-token-at-least-24-characters
MCP_FLEET_REVIEWER_TOKEN=replace-with-a-distinct-reviewer-token-at-least-24-characters
MCP_FLEET_WORKER_TOKENS={"worker1":"replace-with-a-distinct-worker-token-at-least-24-characters"}
MCP_FLEET_BIND_ADDRESS=127.0.0.1
MCP_FLEET_PORT=8788
